# Copy to .env and fill in. .env is gitignored and must stay that way —
# the token below controls the bot completely.
#
#   cp .env.example .env
#   chmod 600 .env
#
# The bot is optional: attendance, the dashboard and counting all work with no
# .env at all. Only Telegram messages need it.

# From @BotFather: /newbot, or /token for an existing bot.
TELEGRAM_BOT_TOKEN=

# Without the @. Used only in messages shown to people, never to authenticate.
TELEGRAM_BOT_USERNAME=
