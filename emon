#!/usr/bin/env bash
# Start, stop and inspect the attendance system.
#
#   ./emon start | stop | restart | status | logs [camera|api|bot]
#
# The bot is only started when data/config.json has telegram_enabled: true, so
# turning Telegram on and off is a config change rather than a different command
# to remember.

set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")"

PY=venv/bin/python
PORT=8800
mkdir -p data

API_PATTERN='uvicorn backend.api:app'
CAM_PATTERN='backend/recognizer.py'
BOT_PATTERN='backend/bot.py'

pids_for() { pgrep -f "$1" 2>/dev/null; }

is_up() { [ -n "$(pids_for "$1")" ]; }

telegram_on() {
  [ -f data/config.json ] || return 1
  $PY -c "
import json,sys
try: sys.exit(0 if json.load(open('data/config.json')).get('telegram_enabled') else 1)
except Exception: sys.exit(1)
" 2>/dev/null
}

wait_gone() {
  # SIGTERM lets the camera release /dev/video0 and the day stay open; only a
  # process that ignores it gets SIGKILL.
  local pattern=$1
  for _ in $(seq 20); do
    is_up "$pattern" || return 0
    sleep 0.5
  done
  pkill -9 -f "$pattern" 2>/dev/null
  sleep 1
}

start_one() {
  local name=$1 pattern=$2 log=$3
  shift 3
  if is_up "$pattern"; then
    echo "  $name — уже работает"
    return
  fi
  nohup "$@" >> "$log" 2>&1 &
  echo "  $name — запущено"
}

cmd_start() {
  # Back up before anything opens the database. A backup is only worth having
  # if it is taken without being asked for, and start-up is the one moment the
  # database is reliably idle.
  if [ -f data/activity.db ]; then
    $PY scripts/backup.py 2>&1 | sed "s/^/  /"
  fi

  echo "Запуск:"
  start_one "API      " "$API_PATTERN" data/api.log \
            $PY -m uvicorn backend.api:app --host 127.0.0.1 --port $PORT
  start_one "Камера   " "$CAM_PATTERN" data/recognizer.log \
            $PY -u backend/recognizer.py
  if telegram_on; then
    start_one "Telegram " "$BOT_PATTERN" data/bot.log $PY -u backend/bot.py
  else
    echo "  Telegram  — выключен (data/config.json: telegram_enabled)"
  fi

  # The camera needs ~20s to load the recognition model before it opens the
  # device, so a status check straight away would always look like a failure.
  echo
  echo "Загрузка модели, 25 секунд…"
  sleep 25
  cmd_status
}

cmd_stop() {
  echo "Остановка:"
  for entry in "Telegram :$BOT_PATTERN" "Камера   :$CAM_PATTERN" "API      :$API_PATTERN"; do
    name=${entry%%:*}
    pattern=${entry#*:}
    if is_up "$pattern"; then
      pkill -f "$pattern" 2>/dev/null
      wait_gone "$pattern"
      echo "  $name — остановлено"
    else
      echo "  $name — не работало"
    fi
  done
  echo
  echo "Открытые дни будут закрыты при следующем запуске, по реальному"
  echo "времени последнего появления — никто не отмечен как ушедший."
}

cmd_status() {
  echo "Состояние:"
  for entry in "API      :$API_PATTERN" "Камера   :$CAM_PATTERN" "Telegram :$BOT_PATTERN"; do
    name=${entry%%:*}
    pattern=${entry#*:}
    pid=$(pids_for "$pattern" | head -1)
    if [ -n "$pid" ]; then
      echo "  $name работает (pid $pid)"
    else
      echo "  $name остановлено"
    fi
  done

  if is_up "$API_PATTERN" && [ -f data/admin_pass.txt ]; then
    echo
    echo "  Дашборд → http://127.0.0.1:$PORT"
    echo "  Админка → http://127.0.0.1:$PORT/admin"
    local state
    state=$(curl -s --max-time 5 -u "admin:$(cat data/admin_pass.txt)" \
            "http://127.0.0.1:$PORT/api/camera/status" 2>/dev/null \
            | $PY -c "
import json,sys
try: s = json.load(sys.stdin)
except Exception: sys.exit()
print(f\"  Камера: {'подключена' if s.get('online') else 'не отвечает'}\"
      f\"  лицо {s.get('max_face_width', 0)}px\"
      f\"  (для остановки нужно {s.get('stand_min_face_width', 0)}px)\")
" 2>/dev/null)
    [ -n "$state" ] && echo "$state"
  fi
}

cmd_logs() {
  case "${1:-camera}" in
    api)    tail -f data/api.log ;;
    bot)    tail -f data/bot.log ;;
    camera) tail -f data/recognizer.log | grep --line-buffered -vE "FutureWarning|tform.estimate" ;;
    *)      echo "logs: camera | api | bot"; exit 1 ;;
  esac
}

case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; echo; cmd_start ;;
  status)  cmd_status ;;
  logs)    cmd_logs "${2:-camera}" ;;
  *)
    echo "Использование: ./emon {start|stop|restart|status|logs [camera|api|bot]}"
    exit 1 ;;
esac
